# Copy to .env and fill in. .env is gitignored and must stay that way.
# Create the Upstox app at https://upstox.com/developer/apps

# Secrets (UPSTOX_API_SECRET, UPSTOX_ACCESS_TOKEN, KITE_API_SECRET,
# TELEGRAM_BOT_TOKEN) belong in the OS keychain, not in this file:
#     trade-terminal credentials set upstox_api_secret
# Values left here still work as a fallback; move them with
#     trade-terminal credentials import --remove-from-env
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Upstox requires https:// even for localhost — self-signed cert in Phase 1
UPSTOX_REDIRECT_URI=https://127.0.0.1:8000/auth/upstox/callback

# Zerodha — Phase 8, leave blank until then.
# App: https://developers.kite.trade  (data APIs Rs 500/mo, execution free)
KITE_API_KEY=
KITE_API_SECRET=

# Alerts — Telegram is instant and reaches your phone. Email is the fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
MODE=backtest          # backtest | paper | live
LOG_LEVEL=INFO
TZ=Asia/Kolkata

# Account-level kill switch. Enforced by the engine; no strategy can override it.
MAX_DAILY_LOSS=
MAX_CONCURRENT_POSITIONS=

# Local API. Loopback names are always allowed; add other hostnames (comma-
# separated) only if you deliberately reach the API under a different name.
API_ALLOWED_HOSTS=
# Extra browser origins allowed to call the API (comma-separated). Only for a
# UI served from another port, such as the end-to-end tests.
API_ALLOWED_ORIGINS=

# Strategy assistant. The API key goes in the OS keychain (Assistant tab),
# not here. LLM_PROVIDER=scripted with LLM_SCRIPT=<file> is for tests only.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_MAX_STEPS=8
LLM_MAX_TOKENS_PER_COMPILE=200000
LLM_MAX_SECONDS=300
