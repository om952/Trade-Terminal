# Copy to .env and fill in. .env is gitignored and must stay that way.
# Create the Upstox app at https://upstox.com/developer/apps

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Upstox requires https:// even for localhost — self-signed cert in Phase 1
UPSTOX_REDIRECT_URI=https://127.0.0.1:8000/auth/upstox/callback

# Zerodha — Phase 8, leave blank until then.
# App: https://developers.kite.trade  (data APIs Rs 500/mo, execution free)
KITE_API_KEY=
KITE_API_SECRET=

# Alerts — Telegram is instant and reaches your phone. Email is the fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
MODE=backtest          # backtest | paper | live
LOG_LEVEL=INFO
TZ=Asia/Kolkata

# Account-level kill switch. Enforced by the engine; no strategy can override it.
MAX_DAILY_LOSS=
MAX_CONCURRENT_POSITIONS=
